[Unit]
Description=Library kiosk web server (kiosk screen, CMS and API)
After=kiosk-storage.service
Wants=kiosk-storage.service

[Service]
Environment=HOST=0.0.0.0
Environment=PORT=8080
Environment=NODE_ENV=production
Environment=STATIC_DIR=%h/kiosk/app/www
EnvironmentFile=-%h/kiosk/kiosk.conf
EnvironmentFile=-%h/kiosk/kiosk.env
WorkingDirectory=%h/kiosk/app/server
ExecStart=%h/kiosk/node/bin/node index.js
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
