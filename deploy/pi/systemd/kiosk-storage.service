[Unit]
Description=Library kiosk object storage (RustFS, S3-compatible, 127.0.0.1 only)

[Service]
EnvironmentFile=%h/kiosk/kiosk.env
Environment=RUSTFS_ADDRESS=127.0.0.1:9000
Environment=RUSTFS_CONSOLE_ENABLE=false
ExecStart=%h/kiosk/rustfs/rustfs server %h/kiosk/data/objects
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
