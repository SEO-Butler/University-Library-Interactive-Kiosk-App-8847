#!/bin/bash
# Build the kiosk + CMS from the repo and publish them with the API server to ~/kiosk/app.
# Usage: kiosk-deploy [--no-reload]
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/kiosk-common.sh"

RELOAD=yes
[ "${1:-}" = "--no-reload" ] && RELOAD=no

if [ ! -x "$NODE_DIR/bin/node" ]; then
  echo "Node is not installed in $NODE_DIR. Run deploy/pi/install.sh first." >&2
  exit 1
fi
export PATH="$NODE_DIR/bin:$PATH"

cd "$REPO_DIR"
COMMIT="$(git rev-parse --short HEAD)"
log "Building $(git rev-parse --abbrev-ref HEAD) @ $COMMIT in $REPO_DIR"

npm ci --no-audit --no-fund --loglevel=error
npm run build
(cd server && npm ci --omit=dev --no-audit --no-fund --loglevel=error)

# Publish atomically: the running server keeps its files until the swap.
# Source maps are left out; they are only useful for debugging.
NEW="$APP_DIR.new"
OLD="$APP_DIR.old"
rm -rf "$NEW" "$OLD"
mkdir -p "$NEW/www"
(cd dist && find . -type f ! -name '*.map' -exec cp --parents {} "$NEW/www/" \;)
cp -a server "$NEW/server"
rm -rf "$NEW/server/test"
echo "$COMMIT" > "$NEW/.deployed-commit"
[ -d "$APP_DIR" ] && mv "$APP_DIR" "$OLD"
mv "$NEW" "$APP_DIR"
rm -rf "$OLD"
log "Published to $APP_DIR"

# The server runs from the published copy, so restart it to pick up the new code.
systemctl --user restart kiosk-web.service
for _ in $(seq 1 30); do
  curl -fs -o /dev/null "${KIOSK_URL}api/health" && break
  sleep 1
done
if curl -fs "${KIOSK_URL}api/health" > /dev/null; then
  log "Server OK at $KIOSK_URL"
else
  log "WARNING: health check failing at ${KIOSK_URL}api/health (systemctl --user status kiosk-web; journalctl --user -u kiosk-web)"
  curl -s "${KIOSK_URL}api/health" || true
  echo
fi

# Restart the kiosk browser so it loads the new build (lwrespawn relaunches it).
if [ "$RELOAD" = yes ] && pkill -f -- "--user-data-dir=$KIOSK_PROFILE"; then
  log "Restarted kiosk browser"
fi
