#!/bin/bash
# Launch Chromium fullscreen on the kiosk app. Run under lwrespawn from the labwc
# autostart, which relaunches it whenever it exits.
set -u
. "$(dirname "$(readlink -f "$0")")/kiosk-common.sh"

# Wait for the local server so Chromium doesn't show a connection error page at boot.
for _ in $(seq 1 30); do
  curl -fs -o /dev/null "$KIOSK_URL" && break
  sleep 1
done

# After a crash or power cut Chromium offers to restore the previous session.
# Mark the last exit as clean so that prompt never appears on the kiosk.
PREFS="$KIOSK_PROFILE/Default/Preferences"
if [ -f "$PREFS" ]; then
  sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"[^"]*"/"exit_type":"Normal"/' "$PREFS"
fi

# No --incognito: the app caches the last good content in localStorage so it can
# boot offline. Visitor state is reset by the app's idle timer instead.
exec /usr/bin/chromium \
  --kiosk "$KIOSK_URL" \
  --user-data-dir="$KIOSK_PROFILE" \
  --ozone-platform=wayland \
  --enable-wayland-ime \
  --noerrdialogs \
  --no-first-run \
  --no-default-browser-check \
  --disable-session-crashed-bubble \
  --disable-pinch \
  --overscroll-history-navigation=0 \
  --disable-features=Translate,TouchpadOverscrollHistoryNavigation \
  --check-for-update-interval=31536000 \
  --password-store=basic
