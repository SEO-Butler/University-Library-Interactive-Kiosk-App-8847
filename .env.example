# Copy to .env for local development and export it before starting the server, e.g.
#   set -a; . ./.env; set +a; npm run dev:server
# On the Raspberry Pi these values live in ~/kiosk/kiosk.conf and ~/kiosk/kiosk.env.

# Where the server listens. 127.0.0.1 = this machine only; 0.0.0.0 = whole network
# (needed for staff to reach the CMS from their own computers).
HOST=127.0.0.1
PORT=8080

# PostgreSQL
DATABASE_URL=postgresql://kiosk:kiosk@127.0.0.1:5432/kiosk

# S3-compatible object storage for images (MinIO, RustFS, Garage, AWS S3, ...)
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=kiosk
S3_SECRET_KEY=kiosksecret123
S3_BUCKET=kiosk-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Built kiosk + CMS to serve (leave unset to serve ../dist relative to server/)
# STATIC_DIR=/home/kiosk/kiosk/app/www

# CMS sessions
SESSION_TTL_HOURS=12
# Set to true when the CMS is served over https (e.g. behind a reverse proxy)
COOKIE_SECURE=false
# Set to true when a reverse proxy sits in front of the server
TRUST_PROXY=false

# First admin account, created only while no CMS users exist.
# Alternatively run: node server/cli.js create-user admin --role admin
CMS_ADMIN_USER=admin
CMS_ADMIN_PASSWORD=

# Restrict QR-code links to these hosts (comma separated, subdomains allowed).
# Empty = any https:// link.
QR_ALLOWED_HOSTS=

# Largest image upload in MB
MAX_UPLOAD_MB=10
